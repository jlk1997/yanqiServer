# M66–M68：匹配自适应背压（核心路径；打分/召回耗时；MATCH_ADAPTIVE_BP=0 关闭）
# MATCH_ADAPTIVE_BP=1
# MATCH_DEMAND_PARALLEL=2
# MATCH_PARALLEL_MIN=1
# MATCH_PARALLEL_MAX=4
# MATCH_WRITE_SHARD=25
# MATCH_WRITE_SHARD_MIN=5
# MATCH_WRITE_SHARD_MAX=80
# MATCH_BP_SLOW_MS=400
# MATCH_BP_FAST_MS=80
# MATCH_BP_SCORE_SLOW_MS=350
# MATCH_BP_SCORE_FAST_MS=60
# MATCH_BP_RECALL_SLOW_MS=300
# MATCH_BP_RECALL_FAST_MS=50
# MATCH_BP_WINDOW=6
# MATCH_SCORE_CHUNK=80
# MATCH_SUPPLY_SCORE_OVERLAP=1
# MATCH_DEMAND_EMBED_LOOKAHEAD=1
# MATCH_DEMAND_EMBED_LOOKAHEAD_N=2

# M70/M71：召回 miss 轻量扩窗（有界）+ 质量闸早停
MATCH_RECALL_LIGHT_EXPAND=1
MATCH_RECALL_LIGHT_EXPAND_MIN=6
MATCH_RECALL_LIGHT_EXPAND_FACTOR=2
MATCH_RECALL_LIGHT_EXPAND_MAX=120
MATCH_RECALL_LIGHT_EXPAND_QUALITY_GATE=1
MATCH_RECALL_LIGHT_EXPAND_MAX_ROUNDS=2
MATCH_RECALL_LIGHT_EXPAND_MIN_GAIN=1
MATCH_RECALL_LIGHT_EXPAND_MIN_DIVERSITY=2
# MATCH_RECALL_LIGHT_EXPAND_GATE_MIN_SCORE=  # 默认跟 minScore
# M70/M71：壳回升 SLA 窗口与临近提醒（毫秒）
INBOX_SHELL_RECOVERY_SLA_MS=900000
# M75：SLA 重开冷却（防 thrash），默认 5 分钟
INBOX_SHELL_SLA_REOPEN_COOLDOWN_MS=300000
INBOX_SHELL_RECOVERY_SLA_WARN_MS=180000

# M72：TopN 多样性重排 / bust 后自动 HIT 探针
MATCH_TOPN_DIVERSITY_RERANK=1
MATCH_TOPN_DIVERSITY_POOL_FACTOR=3
MATCH_TOPN_DIVERSITY_ORG_PENALTY=0.08
MATCH_TOPN_DIVERSITY_KIND_PENALTY=0.04
INBOX_SHELL_POST_BUST_AUTO_HIT_PROBE=1
INBOX_SHELL_POST_BUST_HIT_PROBE_ROUNDS=3

# M82：写库快照压缩/增量 + ANN 冷却×背压联动
MATCH_WRITE_SNAP_COMPRESS=1
MATCH_WRITE_SNAP_INCREMENTAL=1
MATCH_ANN_BP_COOLDOWN_LINK=1
MATCH_ANN_BP_HYSTERESIS=1
MATCH_ANN_BP_HYSTERESIS_BAND_MS=2500
# MATCH_ANN_POOL_CAP_ADAPT_COOLDOWN_MS=12000

# M85/M86/M87：滞回×写片联动冷却；M87 按 BP 延迟分位调节冷却
MATCH_ANN_BP_HYSTERESIS_WRITE_SHARD_LINK=1
MATCH_ANN_BP_HYSTERESIS_WRITE_SHARD_LINK_COOLDOWN_MS=8000
MATCH_ANN_BP_HYSTERESIS_WRITE_SHARD_LINK_DEBOUNCE=1
MATCH_ANN_BP_HYSTERESIS_WRITE_SHARD_COOLDOWN_BP_PCTILE=1

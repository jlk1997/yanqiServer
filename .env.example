API_PORT=3100
WEB_PORT=3200
# 演示密钥只从环境变量读；上线务必轮换
ADMIN_API_KEY=yanqi-admin-demo-key
ADMIN_USER=admin
ADMIN_PASS=yanqi123
ADMIN_EMAIL=admin@yanqi.local
SMTP_MODE=draft_only
